# data caches. dat.rds and sched.rds come from `Rscript update_data.R`;
# colleges.rds is filled in by the render itself, one ESPN request per
# player it has not seen before, so deleting it costs the next render
# about ten seconds and nothing else.
*.rds

# rendered output: ~8 MB per render and git cannot delta-compress it.
# published straight from disk with `quarto publish posit-connect-cloud --no-render`
*.html

